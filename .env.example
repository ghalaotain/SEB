FLASK_ENV=development
APP_MODE=demo
SECRET_KEY=replace-with-a-long-random-value

DATABASE_URL=mysql+pymysql://seb_user:change-me@127.0.0.1:3306/smart_exhibition_booth

AI_ENABLED=false
AI_DETECTOR_BACKEND=opencv
AI_MAX_IMAGE_PIXELS=16000000
INSTALL_AI=false
BOOTH_ID=booth_1
PERSONALIZED_AD_DURATION=15
GENERAL_CAROUSEL_INTERVAL=7

MAX_CONTENT_LENGTH_MB=8

# Optional first-deployment bootstrap. Remove the password after first deploy.
SEED_INITIAL_DATA=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
